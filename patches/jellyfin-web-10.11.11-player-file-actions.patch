diff --git a/src/scripts/playerFileActions.js b/src/scripts/playerFileActions.js
new file mode 100644
--- /dev/null
+++ b/src/scripts/playerFileActions.js
@@ -0,0 +1,47 @@
+export function formatFileSize(size) {
+    if (!Number.isFinite(size) || size < 0) return null;
+    const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
+    const index = size > 0 ? Math.min(Math.floor(Math.log(size) / Math.log(1024)), units.length - 1) : 0;
+    return `${(size / (1024 ** index)).toLocaleString(undefined, { maximumFractionDigits: 2 })} ${units[index]}`;
+}
+
+// The item deletion API also deletes alternate versions and multipart media.
+// Offer this single-file action only when its scope is exactly one local file.
+export function canDeletePlayingFile(item, source) {
+    return Boolean(item?.CanDelete && !item.IsFolder && item.MediaType === 'Video'
+        && item.LocationType === 'FileSystem' && (item.PartCount || 0) <= 1
+        && (item.MediaSourceCount || 0) <= 1 && item.MediaSources?.length === 1
+        && source?.Protocol === 'File' && !source.IsRemote && source.Path
+        && item.MediaSources[0].Id === source.Id && item.MediaSources[0].Path === source.Path
+        && (!item.VideoType || item.VideoType === 'VideoFile'));
+}
+
+// Confirmation, fresh permissions and identity checks all precede stopping.
+// Keep remaining entries before stop(), which resets Jellyfin's local queue.
+export function createPlayerFileDeletion(deps) {
+    let busy = false;
+    return async function (item, source) {
+        if (busy) return 'busy';
+        busy = true;
+        try {
+            if (!canDeletePlayingFile(item, source)) throw new Error('Unsupported deletion');
+            if (!await deps.confirm(item, source)) return 'cancelled';
+            const fresh = await deps.refresh(item);
+            if (!canDeletePlayingFile(fresh, source) || !deps.isCurrent(item, source)) {
+                throw new Error('Playback or deletion scope changed');
+            }
+            const queue = await deps.getQueue();
+            if (!deps.isCurrent(item, source)) throw new Error('Playback changed');
+            const index = deps.getIndex();
+            if (index < 0 || queue[index]?.Id !== item.Id) throw new Error('Queue changed');
+            const remaining = queue.slice(index + 1).filter(entry => entry.Id !== item.Id);
+            await deps.stop();
+            await deps.remove(item);
+            if (remaining.length) await deps.play(remaining);
+            else await deps.finish();
+            return 'deleted';
+        } finally {
+            busy = false;
+        }
+    };
+}
