diff --git a/src/scripts/listPageSize.js b/src/scripts/listPageSize.js
new file mode 100644
--- /dev/null
+++ b/src/scripts/listPageSize.js
@@ -0,0 +1,24 @@
+import * as userSettings from './settings/userSettings';
+import { ServerConnections } from 'lib/jellyfin-apiclient';
+
+export const PAGE_SIZES = [50, 100, 200];
+export const PAGE_SIZE_CHANGE = 'zellyfin-page-size-change';
+
+function key() {
+    return `zellyfin-page-size-${ServerConnections.currentApiClient()?.serverId() || 'default'}`;
+}
+
+export function getPageSize() {
+    const saved = Number(userSettings.get(key(), false));
+    const legacy = userSettings.libraryPageSize();
+    if (PAGE_SIZES.includes(saved)) return saved;
+    if (PAGE_SIZES.includes(legacy)) return legacy;
+    return 100;
+}
+
+export function setPageSize(size) {
+    const next = Number(size);
+    if (!PAGE_SIZES.includes(next) || next === getPageSize()) return;
+    userSettings.set(key(), String(next), false);
+    document.dispatchEvent(new CustomEvent(PAGE_SIZE_CHANGE));
+}
