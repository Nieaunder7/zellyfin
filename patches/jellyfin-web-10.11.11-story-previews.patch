diff --git a/src/scripts/trickplayPreviews.js b/src/scripts/trickplayPreviews.js
new file mode 100644
index 0000000..d89459d
--- /dev/null
+++ b/src/scripts/trickplayPreviews.js
@@ -0,0 +1,95 @@
+const PREVIEW_POINTS = [0.25, 0.5, 0.75];
+
+function formatTime(milliseconds) {
+    const seconds = Math.floor(milliseconds / 1000);
+    const hours = Math.floor(seconds / 3600);
+    const minutes = Math.floor(seconds / 60) % 60;
+    const remainder = seconds % 60;
+    const padded = value => String(value).padStart(2, '0');
+    return hours ? `${hours}:${padded(minutes)}:${padded(remainder)}` : `${minutes}:${padded(remainder)}`;
+}
+
+export function getTrickplayFrames(item, apiClient) {
+    if (item?.MediaType !== 'Video' || !apiClient) return [];
+
+    const fallbackFrames = () => {
+        const durationTicks = item.RunTimeTicks || item.MediaSources?.[0]?.RunTimeTicks;
+        if (!Number.isFinite(durationTicks) || durationTicks <= 0) return [];
+        return PREVIEW_POINTS.map(point => ({
+            percent: Math.round(point * 100),
+            time: formatTime(durationTicks / 10000 * point),
+            url: apiClient.getUrl(`StoryPreview/Items/${item.Id}/${Math.round(point * 100)}.jpg`, {
+                ApiKey: apiClient.accessToken()
+            }),
+            aspectRatio: '16 / 9',
+            backgroundSize: 'cover',
+            backgroundPosition: 'center'
+        }));
+    };
+
+    if (!item.Trickplay || !Object.keys(item.Trickplay).length) return fallbackFrames();
+
+    const mediaSourceId = item.MediaSources?.find(source => item.Trickplay[source.Id])?.Id
+        || Object.keys(item.Trickplay)[0];
+    const resolutions = item.Trickplay[mediaSourceId];
+    const durationTicks = item.RunTimeTicks
+        || item.MediaSources?.find(source => source.Id === mediaSourceId)?.RunTimeTicks;
+    if (!resolutions || !Number.isFinite(durationTicks) || durationTicks <= 0) return fallbackFrames();
+
+    const available = Object.values(resolutions).filter(info =>
+        info.Width > 0 && info.Height > 0 && info.TileWidth > 0 && info.TileHeight > 0
+        && info.Interval > 0 && info.ThumbnailCount > 0);
+    if (!available.length) return fallbackFrames();
+
+    const info = available.slice(1).reduce((closest, current) =>
+        Math.abs(current.Width - 320) < Math.abs(closest.Width - 320) ? current : closest, available[0]);
+    const tileSize = info.TileWidth * info.TileHeight;
+    const durationMs = durationTicks / 10000;
+
+    return PREVIEW_POINTS.map(point => {
+        const frameIndex = Math.min(info.ThumbnailCount - 1,
+            Math.max(0, Math.round(durationMs * point / info.Interval)));
+        const spriteIndex = Math.floor(frameIndex / tileSize);
+        const tileOffset = frameIndex % tileSize;
+        const tileX = tileOffset % info.TileWidth;
+        const tileY = Math.floor(tileOffset / info.TileWidth);
+        const url = apiClient.getUrl(`Videos/${item.Id}/Trickplay/${info.Width}/${spriteIndex}.jpg`, {
+            ApiKey: apiClient.accessToken(),
+            MediaSourceId: mediaSourceId
+        });
+
+        return {
+            percent: Math.round(point * 100),
+            time: formatTime(frameIndex * info.Interval),
+            url,
+            aspectRatio: `${info.Width} / ${info.Height}`,
+            backgroundSize: `${info.TileWidth * 100}% ${info.TileHeight * 100}%`,
+            backgroundPosition: `${info.TileWidth === 1 ? 0 : tileX * 100 / (info.TileWidth - 1)}% ${info.TileHeight === 1 ? 0 : tileY * 100 / (info.TileHeight - 1)}%`
+        };
+    });
+}
+
+export function createTrickplayPreviewStrip(item, apiClient) {
+    const frames = getTrickplayFrames(item, apiClient);
+    if (!frames.length) return null;
+
+    const strip = document.createElement('div');
+    strip.className = 'storyPreviewStrip';
+    for (const frame of frames) {
+        const figure = document.createElement('figure');
+        figure.className = 'storyPreviewFrame';
+        const image = document.createElement('div');
+        image.className = 'storyPreviewImage';
+        image.setAttribute('role', 'img');
+        image.setAttribute('aria-label', `${frame.percent}% · ${frame.time}`);
+        image.style.aspectRatio = frame.aspectRatio;
+        image.style.backgroundImage = `url(${JSON.stringify(frame.url)})`;
+        image.style.backgroundSize = frame.backgroundSize;
+        image.style.backgroundPosition = frame.backgroundPosition;
+        const caption = document.createElement('figcaption');
+        caption.textContent = `${frame.percent}% · ${frame.time}`;
+        figure.append(image, caption);
+        strip.appendChild(figure);
+    }
+    return strip;
+}
