+function rememberStoryPreviewItem(item, serverId) {
+    if (item.MediaType !== 'Video' || !item.RunTimeTicks) return;
+    const key = `${serverId}:${item.Id}`;
+    storyPreviewItems.set(key, Promise.resolve(item));
+    if (storyPreviewItems.size > 150) storyPreviewItems.delete(storyPreviewItems.keys().next().value);
+}
+
+function hideStoryPreview() {
+    clearTimeout(storyPreviewTimer);
+    activeStoryCard = null;
+    storyPreviewPanel?.remove();
+    storyPreviewPanel = null;
+}
+
+function positionStoryPreview(card, panel) {
+    const rect = card.getBoundingClientRect();
+    const margin = 8;
+    const width = Math.min(520, window.innerWidth - margin * 2);
+    panel.style.width = `${width}px`;
+    panel.style.left = `${Math.max(margin, Math.min(window.innerWidth - width - margin, rect.left + rect.width / 2 - width / 2))}px`;
+    const height = panel.getBoundingClientRect().height;
+    const below = rect.bottom + margin;
+    const above = rect.top - height - margin;
+    panel.style.top = `${below + height <= window.innerHeight - margin ? below : Math.max(margin, above)}px`;
+}
+
+function showStoryPreview(card) {
+    if (activeStoryCard === card) return;
+    hideStoryPreview();
+    activeStoryCard = card;
+    storyPreviewTimer = setTimeout(async () => {
+        const serverId = card.dataset.serverid;
+        const itemId = card.dataset.id;
+        const apiClient = ServerConnections.getApiClient(serverId);
+        if (!apiClient || !itemId) return;
+
+        const key = `${serverId}:${itemId}`;
+        let itemPromise = storyPreviewItems.get(key);
+        if (!itemPromise) {
+            itemPromise = apiClient.getItem(apiClient.getCurrentUserId(), itemId).catch(() => {
+                storyPreviewItems.delete(key);
+                return null;
+            });
+            storyPreviewItems.set(key, itemPromise);
+            if (storyPreviewItems.size > 150) storyPreviewItems.delete(storyPreviewItems.keys().next().value);
+        }
+
+        const item = await itemPromise;
+        if (activeStoryCard !== card || !card.isConnected || !item) return;
+        const strip = createTrickplayPreviewStrip(item, apiClient);
+        if (!strip) return;
+
+        const panel = document.createElement('div');
+        panel.className = 'storyPreviewPopover';
+        panel.setAttribute('role', 'group');
+        panel.setAttribute('aria-label', globalize.translate('StoryPreview'));
+        const title = document.createElement('div');
+        title.className = 'storyPreviewTitle';
+        title.textContent = globalize.translate('StoryPreview');
+        panel.append(title, strip);
+        document.body.appendChild(panel);
+        storyPreviewPanel = panel;
+        positionStoryPreview(card, panel);
+    }, 120);
+}
+
+function installStoryPreviewHover() {
+    if (storyPreviewHoverInstalled || !layoutManager.desktop) return;
+    storyPreviewHoverInstalled = true;
+    const onEnter = event => {
+        const card = event.target.closest?.('.card[data-mediatype="Video"]');
+        if (card?.querySelector('.cardOverlayContainer')) showStoryPreview(card);
+    };
+    const onLeave = event => {
+        if (activeStoryCard && activeStoryCard.contains(event.target)
+            && !activeStoryCard.contains(event.relatedTarget)) hideStoryPreview();
+    };
+    document.addEventListener('mouseover', onEnter);
+    document.addEventListener('mouseout', onLeave);
+    document.addEventListener('focusin', onEnter);
+    document.addEventListener('focusout', onLeave);
+    window.addEventListener('scroll', hideStoryPreview, true);
+    window.addEventListener('resize', hideStoryPreview);
+}
 
