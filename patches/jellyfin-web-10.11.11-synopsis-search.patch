diff --git a/src/scripts/synopsisDetails.js b/src/scripts/synopsisDetails.js
new file mode 100644
--- /dev/null
+++ b/src/scripts/synopsisDetails.js
@@ -0,0 +1,53 @@
+export function renderSynopsis(page, item, apiClient) {
+    const section = page.querySelector('.synopsisDetail');
+    if (!section) return;
+    section.dataset.itemId = item.Id;
+    section.classList.add('hide');
+    if (item.MediaType !== 'Video') return;
+
+    const text = section.querySelector('.synopsisDetailText');
+    const meta = section.querySelector('.synopsisDetailMeta');
+    const tags = section.querySelector('.synopsisDetailKeywords');
+    const original = section.querySelector('.synopsisDetailOriginal');
+    const originalText = original.querySelector('p');
+    text.textContent = '';
+    meta.textContent = '';
+    tags.replaceChildren();
+    original.classList.add('hide');
+
+    void apiClient.getJSON(apiClient.getUrl('SceneAnalysis/Items/' + item.Id + '/Synopsis'))
+        .then(data => {
+            if (section.dataset.itemId !== item.Id) return;
+            section.classList.remove('hide');
+            text.textContent = data.synopsis || '';
+            const status = data.reviewStatus === 'needs_review'
+                ? '자동 정리 · 추가 검수 필요' : '기계 번역 · 자동 정리';
+            meta.textContent = (data.code || '') + ' · ' + status;
+            for (const keyword of data.keywords || []) {
+                const chip = document.createElement('span');
+                chip.textContent = keyword;
+                tags.appendChild(chip);
+            }
+            if (data.originalJapanese) {
+                originalText.textContent = data.originalJapanese;
+                original.classList.remove('hide');
+            }
+            if (data.sourceUrl) {
+                try {
+                    const url = new URL(data.sourceUrl);
+                    if (url.hostname === 'www.dmm.co.jp') {
+                        const source = document.createElement('a');
+                        source.href = url.href;
+                        source.target = '_blank';
+                        source.rel = 'noopener noreferrer';
+                        source.textContent = '원문 출처';
+                        meta.append(' · ', source);
+                    }
+                } catch {
+                    // A malformed source URL should not hide the synopsis.
+                }
+            }
+        }).catch(() => {
+            if (section.dataset.itemId === item.Id) section.classList.add('hide');
+        });
+}
