new file mode 100644
--- /dev/null
+++ b/src/apps/stable/features/search/utils/mergePages.ts
@@ -0,0 +1,23 @@
+import { Section } from '../types';
+import { sortSections } from './search';
+
+export function mergeSearchPage(previous: Section[], page: Section[]) {
+    const sections = previous.map(section => ({ ...section, items: section.items.slice() }));
+    let added = 0;
+    for (const next of page) {
+        let section = sections.find(existing => existing.title === next.title);
+        if (!section) {
+            section = { ...next, items: [] };
+            sections.push(section);
+        }
+        const seen = new Set(section.items.map(item => item.Id));
+        for (const item of next.items) {
+            if (!seen.has(item.Id)) {
+                section.items.push(item);
+                seen.add(item.Id);
+                added++;
+            }
+        }
+    }
+    return { sections: sortSections(sections), added };
+}
