+// A page is consumed by server offset, while IDs are de-duplicated for display.
+export function createPagedItems(fetchPage, pageSize = 100) {
+    let items = [];
+    let offset = 0;
+    let hasMore = true;
+    let loading = false;
+    let generation = 0;
+    let latest;
+    let disposed = false;
+    return {
+        get loading() { return loading; },
+        get hasMore() { return hasMore; },
+        dispose() {
+            disposed = true;
+            generation++;
+        },
+        fetch(append = false) {
+            if (disposed) return Promise.resolve({ Items: [], TotalRecordCount: 0, StartIndex: 0 });
+            if (append && loading) return latest;
+            const current = ++generation;
+            const start = append ? offset : 0;
+            const limit = append ? pageSize : Math.max(pageSize, offset);
+            loading = true;
+            latest = Promise.resolve().then(() => fetchPage(start, limit)).then(result => {
+                if (disposed) return { Items: [], TotalRecordCount: 0, StartIndex: 0 };
+                if (current !== generation) return latest;
+                const page = result.Items || [];
+                const combined = append ? items.slice() : [];
+                const seen = new Set(combined.map(item => item.Id));
+                let added = 0;
+                for (const item of page) {
+                    if (!seen.has(item.Id)) {
+                        seen.add(item.Id);
+                        combined.push(item);
+                        added++;
+                    }
+                }
+                items = combined;
+                offset = start + page.length;
+                hasMore = page.length > 0 && (!append || added > 0)
+                    && (Number.isFinite(result.TotalRecordCount) ?
+                        offset < result.TotalRecordCount : page.length >= limit);
+                return { ...result, Items: items, StartIndex: 0 };
+            }).finally(() => {
+                if (current === generation) loading = false;
+            });
+            return latest;
+        }
+    };
+}
