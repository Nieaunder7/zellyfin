diff --git a/src/scripts/sceneAnalysis.js b/src/scripts/sceneAnalysis.js
new file mode 100644
--- /dev/null
+++ b/src/scripts/sceneAnalysis.js
@@ -0,0 +1,122 @@
+const PAGE_SIZE = 30;
+
+function timeLabel(ticks) {
+    const seconds = Math.floor(ticks / 10000000);
+    const hours = Math.floor(seconds / 3600);
+    const minutes = Math.floor(seconds / 60) % 60;
+    const rest = seconds % 60;
+    const pad = value => String(value).padStart(2, '0');
+    return hours ? `${hours}:${pad(minutes)}:${pad(rest)}` : `${pad(minutes)}:${pad(rest)}`;
+}
+
+const STATUS_LABELS = {
+    unprocessed: '아직 분석되지 않았습니다. 시스템 배치 작업에서 처리할 예정입니다.',
+    queued: '분석 대기 중',
+    running: '분석 중',
+    complete: '분석 완료',
+    failed: '분석 실패',
+    stale: '원본 파일이 변경되어 재분석이 필요합니다.'
+};
+
+export function clearSceneAnalysis(page) {
+    const section = page.querySelector('.sceneAnalysisDetail');
+    if (!section) return;
+    clearTimeout(section.refreshTimer);
+    section.dataset.itemId = '';
+}
+
+function renderCards(container, scenes, item, apiClient, playbackManager, start = 0) {
+    const end = Math.min(start + PAGE_SIZE, scenes.length);
+    for (const scene of scenes.slice(start, end)) {
+        const card = document.createElement('article');
+        card.className = 'sceneAnalysisCard';
+
+        const image = document.createElement('img');
+        image.className = 'sceneAnalysisImage';
+        const descriptionText = scene.description ?? scene.Description ?? '';
+        const timeTicks = scene.timeTicks ?? scene.TimeTicks;
+        const imageUrl = scene.imageUrl ?? scene.ImageUrl;
+        image.alt = descriptionText || '장면 미리보기';
+        image.loading = 'lazy';
+        if (imageUrl) image.src = apiClient.getUrl(imageUrl, { ApiKey: apiClient.accessToken() });
+
+        const body = document.createElement('div');
+        body.className = 'sceneAnalysisBody';
+        const jump = document.createElement('button');
+        jump.type = 'button';
+        jump.className = 'sceneAnalysisJump button-flat';
+        jump.textContent = `약 ${timeLabel(timeTicks)}부터 재생`;
+        jump.setAttribute('aria-label', `${timeLabel(timeTicks)} 장면부터 재생`);
+        jump.addEventListener('click', () => playbackManager.play({
+            items: [item],
+            startPositionTicks: timeTicks,
+            sceneJump: true
+        }));
+        const description = document.createElement('p');
+        description.textContent = descriptionText || '장면 설명 없음';
+        const tags = document.createElement('div');
+        tags.className = 'sceneAnalysisTags';
+        for (const tag of scene.tags || scene.Tags || []) {
+            const chip = document.createElement('span');
+            chip.textContent = tag;
+            tags.appendChild(chip);
+        }
+        body.append(jump, description, tags);
+        card.append(image, body);
+        container.appendChild(card);
+    }
+    if (end < scenes.length) {
+        const more = document.createElement('button');
+        more.type = 'button';
+        more.className = 'sceneAnalysisMore button-flat';
+        more.textContent = `장면 더 보기 (${end}/${scenes.length})`;
+        more.addEventListener('click', () => {
+            more.remove();
+            renderCards(container, scenes, item, apiClient, playbackManager, end);
+        });
+        container.appendChild(more);
+    }
+}
+
+export function renderSceneAnalysis(page, item, apiClient, playbackManager) {
+    const section = page.querySelector('.sceneAnalysisDetail');
+    if (!section) return;
+    clearSceneAnalysis(page);
+    section.classList.toggle('hide', item.MediaType !== 'Video');
+    if (item.MediaType !== 'Video') return;
+    section.dataset.itemId = item.Id;
+    const status = section.querySelector('.sceneAnalysisStatus');
+    const content = section.querySelector('.sceneAnalysisContent');
+    status.textContent = '장면 분석 상태를 확인하는 중…';
+    content.replaceChildren();
+
+    const update = async () => {
+        try {
+            const data = await apiClient.getJSON(apiClient.getUrl(`SceneAnalysis/Items/${item.Id}`));
+            if (section.dataset.itemId !== item.Id) return;
+            const state = data.status || data.Status || 'unprocessed';
+            const completed = data.completedSamples ?? data.CompletedSamples ?? 0;
+            const expected = data.expectedSamples ?? data.ExpectedSamples ?? 0;
+            const scenes = data.scenes || data.Scenes || [];
+            const progress = expected ? ` · ${completed}/${expected}` : '';
+            status.textContent = `${STATUS_LABELS[state] || state}${progress}`;
+            if (state === 'failed' && (data.error || data.Error)) status.textContent += ` · ${data.error || data.Error}`;
+            content.replaceChildren();
+            if (scenes.length) {
+                if (state !== 'complete') {
+                    const partial = document.createElement('p');
+                    partial.textContent = '현재까지 분석된 일부 장면입니다. 시각과 태그는 추정값입니다.';
+                    content.appendChild(partial);
+                }
+                const list = document.createElement('div');
+                list.className = 'sceneAnalysisGrid';
+                renderCards(list, scenes, item, apiClient, playbackManager);
+                content.appendChild(list);
+            }
+            if (state === 'running' || state === 'queued') section.refreshTimer = setTimeout(update, 15000);
+        } catch {
+            if (section.dataset.itemId === item.Id) status.textContent = '장면 분석 상태를 불러올 수 없습니다.';
+        }
+    };
+    void update();
+}
diff --git a/src/styles/sceneAnalysis.scss b/src/styles/sceneAnalysis.scss
new file mode 100644
--- /dev/null
+++ b/src/styles/sceneAnalysis.scss
@@ -0,0 +1,68 @@
+.sceneAnalysisDetail {
+    margin: 1.5em 0;
+}
+
+.sceneAnalysisStatus {
+    opacity: .8;
+}
+
+.sceneAnalysisGrid {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+    gap: 1em;
+}
+
+.sceneAnalysisCard {
+    overflow: hidden;
+    border-radius: .55em;
+    background: rgba(128, 128, 128, .14);
+}
+
+.sceneAnalysisImage {
+    display: block;
+    width: 100%;
+    aspect-ratio: 16 / 9;
+    object-fit: cover;
+}
+
+.sceneAnalysisBody {
+    padding: .7em;
+}
+
+.sceneAnalysisBody p {
+    margin: .45em 0;
+}
+
+.sceneAnalysisTags {
+    display: flex;
+    flex-wrap: wrap;
+    gap: .3em;
+}
+
+.sceneAnalysisTags span {
+    padding: .15em .5em;
+    border-radius: 1em;
+    background: rgba(128, 128, 128, .25);
+    font-size: .85em;
+}
+
+.sceneSearchForm {
+    margin: .5em 0 1em;
+}
+
+.sceneSearchControls {
+    display: flex;
+    flex-wrap: wrap;
+    gap: .5em;
+    margin-top: .4em;
+}
+
+.sceneSearchInput {
+    flex: 1 1 18em;
+    min-width: 0;
+    padding: .65em;
+    border: 1px solid currentColor;
+    border-radius: .4em;
+    background: transparent;
+    color: inherit;
+}
