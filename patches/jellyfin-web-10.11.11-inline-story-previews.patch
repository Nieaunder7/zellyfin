diff --git a/src/scripts/inlineStoryPreviews.js b/src/scripts/inlineStoryPreviews.js
new file mode 100644
--- /dev/null
+++ b/src/scripts/inlineStoryPreviews.js
@@ -0,0 +1,93 @@
+import { ServerConnections } from 'lib/jellyfin-apiclient';
+import { createStoryPreviewStrip } from 'scripts/trickplayPreviews';
+
+const items = new Map();
+let observer;
+let mutations;
+
+export function rememberInlineStoryPreviewItem(item, serverId) {
+    if (item.MediaType !== 'Video' || !item.RunTimeTicks) return;
+    const key = `${serverId}:${item.Id}`;
+    items.set(key, Promise.resolve(item));
+    if (items.size > 250) items.delete(items.keys().next().value);
+}
+
+async function loadPreview(container) {
+    if (!container.isConnected || container.dataset.storyPreviewState) return;
+    container.dataset.storyPreviewState = 'loading';
+    const card = container.closest('.card[data-mediatype="Video"]');
+    const serverId = card?.dataset.serverid;
+    const itemId = card?.dataset.id;
+    const client = ServerConnections.getApiClient(serverId);
+    if (!client || !itemId) {
+        container.hidden = true;
+        return;
+    }
+
+    const key = `${serverId}:${itemId}`;
+    let itemPromise = items.get(key);
+    if (!itemPromise) {
+        itemPromise = client.getItem(client.getCurrentUserId(), itemId).catch(() => {
+            items.delete(key);
+            return null;
+        });
+        items.set(key, itemPromise);
+        if (items.size > 250) items.delete(items.keys().next().value);
+    }
+
+    try {
+        const item = await itemPromise;
+        if (!container.isConnected) return;
+        if (!item) {
+            container.hidden = true;
+            container.dataset.storyPreviewState = 'empty';
+            return;
+        }
+        const strip = await createStoryPreviewStrip(item, client, 6);
+        if (!container.isConnected) return;
+        if (strip) {
+            container.appendChild(strip);
+            container.dataset.storyPreviewState = 'ready';
+            container.setAttribute('aria-busy', 'false');
+        } else {
+            container.hidden = true;
+            container.dataset.storyPreviewState = 'empty';
+        }
+    } catch {
+        container.hidden = true;
+        container.dataset.storyPreviewState = 'empty';
+    }
+}
+
+function observeContainer(container) {
+    if (container.dataset.storyPreviewObserved) return;
+    container.dataset.storyPreviewObserved = 'true';
+    if (observer) observer.observe(container);
+    else void loadPreview(container);
+}
+
+function observeAddedCards(node) {
+    if (node.nodeType !== 1) return;
+    if (node.matches?.('.storyPreviewInline')) observeContainer(node);
+    node.querySelectorAll?.('.storyPreviewInline').forEach(observeContainer);
+}
+
+export function installInlineStoryPreviews() {
+    if (mutations || !document.body) return;
+    if (window.IntersectionObserver) {
+        observer = new window.IntersectionObserver(entries => {
+            for (const entry of entries) {
+                if (!entry.isIntersecting) continue;
+                observer.unobserve(entry.target);
+                void loadPreview(entry.target);
+            }
+        }, { rootMargin: '300px 0px' });
+    }
+    mutations = new window.MutationObserver(records => {
+        for (const record of records) {
+            record.addedNodes.forEach(observeAddedCards);
+        }
+    });
+    mutations.observe(document.body, { childList: true, subtree: true });
+    document.querySelectorAll('.storyPreviewInline').forEach(observeContainer);
+}
