diff --git a/src/scripts/sceneSearchPosition.js b/src/scripts/sceneSearchPosition.js
new file mode 100644
--- /dev/null
+++ b/src/scripts/sceneSearchPosition.js
@@ -0,0 +1,15 @@
+export function formatSceneTime(ticks) {
+    const seconds = Math.floor(Math.max(0, Number(ticks) || 0) / 10000000);
+    const hours = Math.floor(seconds / 3600);
+    const minutes = Math.floor(seconds / 60) % 60;
+    const rest = seconds % 60;
+    const pad = value => String(value).padStart(2, '0');
+    return hours ? `${hours}:${pad(minutes)}:${pad(rest)}` : `${pad(minutes)}:${pad(rest)}`;
+}
+
+export function getSceneSearchPosition(timeTicks, durationTicks) {
+    const duration = Number(durationTicks);
+    if (!Number.isFinite(duration) || duration <= 0) return null;
+    const position = Math.max(0, Number(timeTicks) || 0);
+    return Math.round(Math.min(100, position / duration * 100) * 10) / 10;
+}
